{
  "name": "rayhana-suites",
  "version": "2.0.0",
  "description": "ريحانة للوحدات السكنية - Rayhana Suites ERP",
  "main": "main.js",
  "author": "Rayhana Management",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "circular": "node scripts/check-circular.js",
    "baseline:check": "node scripts/baseline.js check",
    "baseline:update": "node scripts/baseline.js update",
    "guard": "node scripts/refactor-guard.js",
    "test:unit": "node --test",
    "test:quick": "npm run lint && npm run baseline:check && npm run guard && npm run test:unit",
    "reset-db": "node reset-db.js",
    "seed:test-data": "node scripts/seed-scratch.js --include-future-cases",
    "import-guests": "node import-guests.js",
    "brand": "node scripts/apply-brand.js",
    "build": "electron-builder --win",
    "builder": "electron-builder --win",
    "dist": "node scripts/build-dist.js",
    "dist:all": "node scripts/build-dist.js --all",
    "dist:rayhana": "node scripts/build-dist.js --rayhana",
    "dist:general": "node scripts/build-dist.js --general",
    "dist:single": "node scripts/build-dist.js --single",
    "dist:builder": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "sql.js": "^1.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "eslint": "^10.11.0",
    "madge": "^8.0.0"
  },
  "build": {
    "appId": "com.hotel.hotel_1",
    "productName": "Rayhana Suites",
    "copyright": "Copyright © 2026 مؤسسة مكتب شمس المنازل للخدمات العقارية. All rights reserved.",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.ico",
      "legalTrademarks": "Rayhana Suites™",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rayhana Suites",
      "uninstallDisplayName": "Rayhana Suites ERP",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "db/**/*",
      "ipc/**/*",
      "backupScheduler.js",
      "businessDayScheduler.js",
      "icon.ico",
      "rayhana-logo.png",
      "app-lock.html",
      "login.html",
      "login.js",
      "dashboard.html",
      "dashboard-app.js",
      "dashboard-overview.js",
      "dashboard-tables.css",
      "dashboard-logs.js",
      "dashboard-admin.js",
      "dashboard-guests.js",
      "dashboard-rooms.js",
      "dashboard-reservations.js",
      "dashboard.js",
      "command-palette.js",
      "hotkeys.js",
      "design-tokens.css",
      "styles.css",
      "css/**/*",
      "assets/**/*",
      "config/**/*",
      "node_modules/**/*"
    ]
  }
}
